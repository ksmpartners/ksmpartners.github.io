---
import PageLayout from '../../layouts/PageLayout.astro';

const base = import.meta.env.BASE_URL;
const e6r3 = 'https://database.ich.org/sites/default/files/ICH_E6%28R3%29_Step4_FinalGuideline_2025_0106.pdf';
const howItWorks = `${Astro.url.pathname}#how-it-works`;

/*
  Screenshots
  -----------
  Each feature slot shows a labelled placeholder until its image exists. To fill or
  replace one, save the image as public/images/clinical-data-repository/<name>.webp
  (.png and .jpg also work). The page picks it up on the next build.

  hero            optional, sits behind the hero under a dark overlay
  pipeline        optional, the pipeline graph, shown under the four steps
  study-overview  study dashboard, Study overview page (Transfers table)
  what-changed    values that changed between transfers
  discrepancies   study dashboard, Discrepancies page
  data-cuts       study dashboard, Data cuts page (crop out the Released by column)
  sce-read        the SCE session reading a pinned data cut
*/
const imageDir = 'images/clinical-data-repository';
// Only the file names are read here; the images are served from public/ as usual.
const found = Object.keys(import.meta.glob('/public/images/clinical-data-repository/*.{webp,png,jpg}'));
const findImage = (name: string) => {
  const file = found.find(path => path.split('/').pop()?.split('.')[0] === name);
  return file ? `${base}${imageDir}/${file.split('/').pop()}` : undefined;
};

const heroImage = findImage('hero');
const pipelineImage = findImage('pipeline');

const problems = [
  { title: 'Reconciling every source', body: 'Every EDC, lab and vendor uses its own format and conventions. A subject or sample that does not match across them can go unnoticed for months.' },
  { title: 'Changes nobody flagged', body: 'Sites correct entries and vendors resend files for the whole study. A value that changed without notice can reach statistics before anyone sees it.' },
  { title: 'Review evidence built by hand', body: 'Review plans hold hundreds of checks. Proving each one ran is manual work, and what slips through comes back as a wave of site queries right before lock.' },
  { title: 'A copy at every hand-off', body: 'Each hand-off to an SCE or a CRO creates another copy to move, validate and keep in sync, and makes it harder to show who changed what.' },
];

const steps = [
  { title: 'Received', body: 'Your EDCs, labs and vendors keep sending files the way they do today. Every transfer is kept exactly as it arrived.' },
  { title: 'Brought together', body: 'Each source is mapped into one view of the study, and every subject is matched against enrollment.' },
  { title: 'Checked', body: 'Your review plan and transfer agreement checks run on each transfer. Every discrepancy is tracked from the day it opens to the day it closes.' },
  { title: 'Read in place', body: 'Statistical programming reads the same copy from the SCE, live or pinned to a released data cut.' },
];

const features = [
  {
    label: 'Study overview',
    title: 'Has every source delivered, and what is open?',
    body: 'Your data managers start the day with the state of the study in one view: which sources have delivered, which are behind, and how many discrepancies opened and closed with the last transfer.',
    bullets: [
      'A subject missing from one source comes to light months before lock',
      'Open discrepancies by source and site show where to focus',
    ],
    image: 'study-overview',
    capture: 'Study dashboard, Study overview page',
    alt: 'Transfers table listing each source with its last transfer date, its status, and its open, opened and closed discrepancy counts',
  },
  {
    label: 'Change over time',
    title: 'What changed since the last transfer?',
    body: 'Every transfer is compared with the one before it, and every version of every value is kept. Your team sees what is new and what changed without comparing files.',
    bullets: [
      'A value a vendor changed without flagging it is caught the day the file arrives',
      'EDC corrections keep who made them, when and why',
      'Review time goes to the records that changed',
    ],
    image: 'what-changed',
    capture: 'Values that changed between transfers',
    alt: 'Five lab results listed with their old and new values, each resent without an update flag',
  },
  {
    label: 'Review evidence',
    title: 'Did the check run, and when did the discrepancy close?',
    body: 'Checks from your data review plan and your transfer agreements run against every transfer. Each discrepancy is recorded with the date it opened and the date it closed, so the evidence builds while the study runs.',
    bullets: [
      'Show an inspector that a check ran and what it raised',
      'Issues come to light during the study, well ahead of lock',
      'Your data managers decide which checks each study runs',
    ],
    image: 'discrepancies',
    capture: 'Study dashboard, Discrepancies page',
    alt: 'Central lab discrepancies with their status, the dates each one opened and closed, and the check that raised it',
  },
  {
    label: 'Data cuts',
    title: 'Which data did this analysis use?',
    body: 'A data cut names the state of the study on a given date, across every source. An analysis pinned to a cut returns the same numbers next month, whatever has arrived since.',
    bullets: [
      'Each release records who released it and when',
      'An auditor can trace a cut back to its files and the code that built it without asking anyone',
    ],
    image: 'data-cuts',
    capture: 'Study dashboard, Data cuts page',
    alt: 'Released data cuts with their as-of date, pipeline run and code commit, above the list of files included in a cut',
  },
  {
    label: 'SCE hand-off',
    title: 'Can programming start without another copy?',
    body: 'Your SCE reads the study data where it lives, from R, SAS or Python. There is no export to move, validate and keep in sync.',
    bullets: [
      'Works with the SCE you already run',
      'Access is read-only, and treatment arm and kit data are kept out of what the SCE can see',
      'Every table names the team that owns it',
    ],
    image: 'sce-read',
    capture: 'The SCE session reading a pinned data cut',
    alt: 'The demographics table open in Positron, read from a pinned data cut with 219 rows',
  },
].map(f => ({ ...f, src: findImage(f.image) }));

const audiences = [
  { title: 'Clinical data management', body: 'Reconcile vendor data the day it arrives, and spend review time on the values that changed. A missing subject is raised months before lock.' },
  { title: 'Statistical programming', body: 'Start programming with no extra copy to move or validate. Pin a program to a data cut and rerun it next month for the same numbers.' },
  { title: 'Quality and inspection readiness', body: 'Show an inspector who owned the data at each stage, who released a cut and what went into it, without a request to anyone.' },
  { title: 'Clinical operations', body: 'See which sources are behind and which sites carry the open discrepancies while there is still time to act.' },
  { title: 'Data strategy and IT', body: 'One copy of the study, fewer transfers between systems, and nothing to replace. It runs on Databricks alongside the EDC, vendors and SCE you already have.' },
];
---
<PageLayout
  title="Clinical Data Repository on Databricks"
  description="A clinical data repository on Databricks for trial sponsors. Bring EDC, lab and IRT data into one place, see what changed in each transfer, and let your SCE read it in place."
>

  <!-- Hero -->
  <section
    class={`hero${heroImage ? ' cdr-hero--image' : ''}`}
    style={heroImage ? `--cdr-hero-bg: url(${heroImage})` : undefined}
  >
    <span class="overline">Clinical Data Repository on Databricks</span>
    <h1>Trust your study data from the first transfer to database lock</h1>
    <p>
      All your study sources, from EDCs to central labs and external vendors, in one unified layer
      your SCE reads in place. Discrepancies tracked, changes surfaced, and issues raised months
      before lock,&nbsp;not&nbsp;days.
    </p>
    <div class="hero-actions">
      <a href="contact" class="btn btn-teal">Request a demo</a>
      <a href={howItWorks} class="btn btn-outline">See how it works</a>
    </div>
    <a href="our-partners" class="hero-built-on">
      <span>Built on</span>
      <img src={`${base}images/partners/databricks-white.svg`} alt="Databricks" width="713" height="113" />
    </a>
  </section>

  <!-- Problem -->
  <div class="section">
    <div class="cdr-intro">
      <div>
        <span class="overline">The problem</span>
        <h2>Most of your study data never passes through the EDC</h2>
        <p class="intro-para">
          Central labs, IRT, eCOA and other vendors each send data in their own format, and many
          studies run more than one EDC across in-house and CRO work. Speakers at the SCDM
          conference in September 2026 put the share of study data outside the EDC at about 70%,
          and named vendor data the leading cause of end-of-study delay. Problems in that data
          tend to surface late, in statistics or in the rush before database lock.
        </p>
      </div>
      <aside class="cdr-reg-block">
        <div class="cdr-label">ICH E6(R3)</div>
        <p>
          <a href={e6r3} target="_blank" rel="noopener noreferrer">E6(R3)</a> asks for oversight in
          proportion to risk, defined critical-to-quality factors, and evidence of who owns the data
          at each stage and how it was transferred and transformed. The repository helps you build
          that evidence from the first transfer.
        </p>
      </aside>
    </div>
    <div class="cdr-problems">
      {problems.map(p => (
        <div class="cdr-problem">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- How it works -->
  <div class="section-pale" id="how-it-works">
    <div class="section">
      <span class="overline">How it works</span>
      <h2>One copy of the study, from vendor file to SCE</h2>

      <div class="cdr-core">
        <ol class="cdr-stages">
          {steps.map((s, i) => (
            <li class="cdr-stage">
              <span class="cdr-stage-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>

      {pipelineImage && (
        <figure class="cdr-pipeline">
          <img
            src={pipelineImage}
            alt="Pipeline graph in Databricks with data from two EDCs, a central lab and IRT flowing into one set of study tables"
            loading="lazy"
          />
          <figcaption class="image-caption">
            The pipeline behind those four steps, running in Databricks
          </figcaption>
        </figure>
      )}
    </div>
  </div>

  <!-- Features -->
  <div class="section">
    <span class="overline">What you get</span>
    <h2>The questions it answers</h2>
    <div class="cdr-features">
      {features.map((f, i) => (
        <div class={`cdr-feature${i % 2 ? ' cdr-feature--reverse' : ''}`}>
          <div class="cdr-feature-text">
            <span class="cdr-label">{f.label}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <ul class="cdr-list">
              {f.bullets.map(b => <li>{b}</li>)}
            </ul>
          </div>
          <div class="cdr-feature-media">
            {f.src ? (
              <img src={f.src} alt={f.alt} loading="lazy" />
            ) : (
              <div class="cdr-shot" role="img" aria-label={`Screenshot to come: ${f.capture}`}>
                <span class="cdr-shot-tag">Screenshot placeholder</span>
                <strong>{f.capture}</strong>
                <code>public/{imageDir}/{f.image}.webp</code>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
    <p class="cdr-note">Screens show generated study data.</p>
  </div>

  <!-- Who benefits -->
  <div class="section-pale">
    <div class="section">
      <span class="overline">Who benefits</span>
      <h2>One copy, useful to every team that touches the data</h2>
      <div class="grid-3 cdr-audiences">
        {audiences.map(a => (
          <div class="card">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Where it leads / CTA -->
  <div class="section cdr-cta">
    <div>
      <span class="overline">Where it leads</span>
      <h2>The first step toward an AI-driven future is one copy of the right data</h2>
      <p>
        AI tools are only as good as the data underneath them. One copy of the right study data,
        reachable in the right way by every team that needs it, is the first step toward using
        them well, and the one that does the most. It gives you the traceability a submission asks
        for today and a base for the AI-enabled SCE that comes next.
      </p>
      <div class="hero-actions cdr-cta-actions">
        <a href="contact" class="btn">Request a demo</a>
        <a href="solutions/sce-scoping" class="btn btn-ghost">See the 12-Week SCE Blueprint</a>
      </div>
    </div>
    <div class="cdr-cta-stat">
      <span>KSM Technology Partners has over</span>
      <strong>23 years</strong>
      <span>building data-intensive systems for regulated industries.</span>
    </div>
  </div>

</PageLayout>

<style>
  .cdr-hero--image {
    background-image:
      linear-gradient(rgba(0, 31, 46, 0.82), rgba(0, 31, 46, 0.82)),
      var(--cdr-hero-bg);
    background-size: cover;
    background-position: center;
  }

  .overline {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .cdr-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
    display: block;
  }

  .intro-para {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-slate-gray);
  }

  /* Problem */
  .cdr-intro {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-16);
    align-items: start;
  }

  .cdr-reg-block {
    background: var(--color-primary);
    border-radius: 0.75rem;
    padding: var(--space-8);
    box-shadow: 0 2px 6px rgba(29, 47, 61, 0.08), 0 12px 32px rgba(29, 47, 61, 0.14);
  }

  .cdr-reg-block p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
  }

  .cdr-reg-block a {
    color: #7ecfee;
    font-weight: 600;
  }

  .cdr-reg-block a:hover,
  .cdr-reg-block a:focus-visible { color: #fff; }

  .cdr-problems {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .cdr-problem {
    border-top: 3px solid var(--color-accent);
    padding-top: var(--space-4);
  }

  .cdr-problem h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .cdr-problem p {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-slate-gray);
    margin: 0;
  }

  /* How it works: four steps on one panel */
  .cdr-core {
    margin-top: var(--space-8);
    background: var(--color-slate);
    background-image:
      radial-gradient(circle at 12% 0%, rgba(60, 157, 204, 0.18) 0%, transparent 50%),
      radial-gradient(circle at 92% 100%, rgba(14, 168, 152, 0.12) 0%, transparent 45%);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: 0 2px 6px rgba(29, 47, 61, 0.1), 0 18px 44px rgba(29, 47, 61, 0.22);
  }

  .cdr-stages {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 2px solid rgba(255, 255, 255, 0.16);
  }

  .cdr-stage {
    position: relative;
    padding: var(--space-6) var(--space-6) 0 0;
  }

  .cdr-stage + .cdr-stage { padding-left: var(--space-6); border-left: 1px solid rgba(255, 255, 255, 0.1); }

  .cdr-stage:last-child { padding-right: 0; }

  /* Marker on the rail above each step */
  .cdr-stage::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-blue);
    box-shadow: 0 0 0 4px var(--color-slate);
  }

  .cdr-stage + .cdr-stage::before { left: var(--space-6); }

  .cdr-stage-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-blue-mid);
    display: block;
    margin-bottom: var(--space-2);
  }

  .cdr-stage h3 {
    color: #fff;
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .cdr-stage p {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.9rem;
    line-height: 1.65;
    margin: 0;
  }

  /* Features */
  .cdr-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-top: var(--space-10);
  }

  /* The screenshots are wide, so the image column gets the larger share */
  .cdr-feature {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-12);
    align-items: center;
  }

  .cdr-feature--reverse { grid-template-columns: 7fr 5fr; }

  .cdr-feature--reverse .cdr-feature-text { order: 2; }

  .cdr-feature-text h3 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .cdr-feature-text p {
    color: var(--color-slate-gray);
    line-height: 1.7;
  }

  .cdr-pipeline { margin-top: var(--space-10); }

  .cdr-feature-media img,
  .cdr-pipeline img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    border: 1px solid rgba(178, 209, 234, 0.5);
    box-shadow:
      0 2px 6px rgba(29, 47, 61, 0.06),
      0 16px 40px rgba(29, 47, 61, 0.14);
  }

  /* Screenshot placeholder, shown until the image file exists */
  .cdr-shot {
    aspect-ratio: 16 / 10;
    border: 2px dashed var(--color-blue-pale);
    border-radius: 0.75rem;
    background-color: var(--color-surface);
    background-image:
      linear-gradient(rgba(178, 209, 234, 0.22) 1px, transparent 1px),
      linear-gradient(90deg, rgba(178, 209, 234, 0.22) 1px, transparent 1px);
    background-size: 28px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-6);
    text-align: center;
  }

  .cdr-shot-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .cdr-shot strong {
    color: var(--color-slate);
    font-size: var(--text-lg);
    line-height: 1.3;
    max-width: 30ch;
  }

  .cdr-shot code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-slate-gray);
    background: var(--color-bg);
    border: 1px solid var(--color-blue-pale);
    border-radius: var(--radius-sm);
    padding: 0.2em 0.6em;
    overflow-wrap: anywhere;
  }

  .cdr-list {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cdr-list li {
    font-size: 0.925rem;
    line-height: 1.55;
    color: var(--color-slate-gray);
    padding-left: 1.25rem;
    position: relative;
  }

  .cdr-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .cdr-note {
    margin: var(--space-10) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-slate-gray);
  }

  /* Who benefits */
  .cdr-audiences { margin-top: var(--space-8); }

  .cdr-audiences .card p {
    line-height: 1.65;
    margin: 0;
  }

  /* Built for / CTA */
  .cdr-cta {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-16);
    align-items: center;
  }

  .cdr-cta p {
    color: var(--color-slate-gray);
    line-height: 1.7;
  }

  .cdr-cta-actions {
    justify-content: flex-start;
    margin-top: var(--space-6);
  }

  .cdr-cta-stat {
    background: var(--color-primary);
    color: #fff;
    border-radius: 1rem;
    padding: var(--space-8);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cdr-cta-stat span {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.5;
  }

  .cdr-cta-stat strong {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  @media (max-width: 960px) {
    .cdr-problems { grid-template-columns: repeat(2, 1fr); }

    .cdr-stages {
      grid-template-columns: repeat(2, 1fr);
      row-gap: var(--space-8);
      border-top: none;
    }

    .cdr-stage,
    .cdr-stage + .cdr-stage {
      padding: var(--space-4) var(--space-6) 0 0;
      border-left: none;
      border-top: 2px solid rgba(255, 255, 255, 0.16);
    }

    .cdr-stage + .cdr-stage::before { left: 0; }
  }

  @media (max-width: 768px) {
    .cdr-intro,
    .cdr-feature,
    .cdr-cta { grid-template-columns: 1fr; gap: var(--space-8); }

    .cdr-feature--reverse .cdr-feature-text { order: 0; }

    .cdr-core { padding: var(--space-6); }
  }

  @media (max-width: 520px) {
    .cdr-problems,
    .cdr-stages { grid-template-columns: 1fr; }

    .cdr-stage,
    .cdr-stage + .cdr-stage { padding-right: 0; }
  }
</style>
