---
import PageLayout from '../layouts/PageLayout.astro';
import SolutionCard from '../components/SolutionCard.astro';
import IEEPillars from '../components/IEEPillars.astro';

// Optional notification banner — present if src/data/notification.md exists
// and its frontmatter has `enabled: true`.
const notificationModules = import.meta.glob('../data/notification.md', { eager: true });
const notification = Object.values(notificationModules)[0] as
  | { frontmatter: { enabled?: boolean }; Content: any }
  | undefined;
const showNotification = notification?.frontmatter?.enabled === false;
const NotificationContent = notification?.Content;

const base = import.meta.env.BASE_URL;

const solutions = [
  {
    title: 'Clinical trials data analysis and reporting',
    body: 'GxP-compliant statistical computing environment for processing clinical trials data into submission-ready results using orchestrated data pipelines and modern data science tools — shrinking cycle times from first patient to analysis completion.',
    image: `${base}images/case-studies/biostats-programming.webp`,
    alt: 'GxP-compliant clinical-trial data pipeline',
    link: 'case-studies/statistical-computing-environment',
  },
  {
    title: 'AI-powered sentiment detection',
    body: 'AI-powered sentiment analyses across high volumes of textual data to detect emerging signals about therapies and preemptively answer questions from healthcare providers and patients.',
    image: `${base}images/case-studies/data-engineering.jpg`,
    alt: 'AI-powered therapy signal detection',
    link: 'case-studies/data-engineering',
  },
  {
    title: 'Dispatch call analytics',
    body: 'ISOs spend hundreds of hours manually transcribing control room communications to find a single instruction or MW value. Dispatch Call Analytics turns every call into a searchable, speaker-labeled transcript, with playback from the exact moment it was said, so compliance and market settlements teams get timestamped evidence in seconds.',
    image: `${base}images/dispatch-call-analytics/call-log.webp`,
    alt: 'Dispatch call log with transcript status icons',
    link: 'solutions/dispatch-call-analytics',
  },
  {
    title: 'Real-time power flow calculation',
    body: 'Mission-critical nodal calculation platform for an Independent System Operator that computes real-time electricity flow across interfaces with neighboring ISOs. Ingests, processes, and indexes 300+ GB of data per day, integrates with more than a dozen upstream systems, and retains five years of records for audit and re-execution.',
    image: `${base}images/case-studies/real-time-power-flow.jpg`,
    alt: 'Real-time power flow calculation engine',
    link: 'case-studies/real-time-power-flow',
  },
];
---
<PageLayout title="Home" description="KSM Technology Partners — Custom software and systems integration for Regulated Industries.">

  {showNotification && NotificationContent && (
    <div class="notification-banner" role="status">
      <div class="notification-banner-inner">
        <NotificationContent />
      </div>
    </div>
  )}

  <!-- Hero -->
  <section class="hero" style="min-height: 55vh;">
    <div class="hero-panels">
      <div class="hero-panel" style={`background-image: url(${import.meta.env.BASE_URL}images/hero-left.webp)`}></div>
      <div class="hero-panel" style={`background-image: url(${import.meta.env.BASE_URL}images/hero-center.webp)`}></div>
      <div class="hero-panel" style={`background-image: url(${import.meta.env.BASE_URL}images/hero-right.webp)`}></div>
    </div>
    <!-- <span class="overline">Computing solutions for data-intensive workloads in regulated industries</span> -->
    <h1>Innovate. Execute. Empower.</h1>
    <p>Innovative computing solutions for data-intensive workloads in regulated industries.</p>
    <div class="hero-actions">
      <a href="contact" class="btn btn-teal">Schedule a Discovery Call</a>
    </div>
  </section>

  <!-- Stats Bar -->
  <div class="stats-bar">
    <div class="stats-bar-inner">
      <div class="stat-item">
        <span class="stat-num">23+ years</span>
        <span class="stat-label">Delivering results</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">75+</span>
        <span class="stat-label">Completed projects</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">0</span>
        <span class="stat-label">Slideware specialists</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">100%</span>
        <span class="stat-label">Fueled by passion</span>
      </div>
    </div>
  </div>

  <!-- Solutions -->
  <div class="section-pale">
    <div class="section">
      <div class="section-heading centered">
        <span class="overline">What We Deliver</span>
        <h2>Solutions for data-intensive workloads where compliance is non-negotiable</h2>
        <p>We deliver solutions that transform mission-critical data assets into submission-ready artifacts that auditors can sign off on. Our domain experts have over 20 years of experience in life sciences and utilities, and we understand their unique regulatory requirements. Below are some of the solutions we've successfully delivered.</p>
      </div>
      <div class="solutions-grid">
        {solutions.map(s => (
          <SolutionCard
            title={s.title}
            body={s.body}
            image={s.image}
            alt={s.alt}
            link={s.link}
          />
        ))}
      </div>
    </div>
  </div>

  <!-- Our Partners -->
  <div class="partners-banner">
    <span class="overline" style="color: var(--color-teal);">Our Partners</span>
    <h2>Built on industry-leading platforms</h2>
    <p>We build our solutions around industry-leading data and AI platforms to deliver the highest value coefficient for our customers.</p>
    <div class="partners-logos">
      <a href="our-partners" class="partner-logo-link">
        <img src={`${base}images/partners/databricks-white.svg`} alt="Databricks" loading="lazy" />
      </a>
      <a href="our-partners" class="partner-logo-link">
        <img src={`${base}images/partners/anthropic-white.svg`} alt="Anthropic" loading="lazy" />
      </a>
      <a href="our-partners" class="partner-logo-link">
        <img src={`${base}images/partners/posit-white.svg`} alt="Posit" loading="lazy" />
      </a>
      <a href="our-partners" class="partner-logo-link">
        <img src={`${base}images/partners/domino-data-labs-white.svg`} alt="Domino Data Lab" loading="lazy" />
      </a>
    </div>
    <a href="our-partners" class="btn btn-teal">Learn About Our Partnerships</a>
  </div>

  <!-- About Blurb -->
  <div class="section-pale">
    <div class="section">
      <div style="max-width: 720px; margin: 0 auto; text-align: center;">
        <span class="overline">About Us</span>
        <h2>Solutions-focused Innovation</h2>
        <p style="font-size: var(--text-lg); color: var(--color-slate-gray); line-height: 1.65;">
          KSM Technology Partners is a systems integrator and software development shop based outside Philadelphia. We draw on deep domain expertise in life sciences and utilities to deliver advanced data analytics and AI solutions.
        </p>
        <a href="about" class="btn-ghost btn" style="margin-top: var(--space-4);">Learn More About Us</a>
      </div>
    </div>
  </div>

  <!-- Our Philosophy -->
  <IEEPillars />

  <!-- CTA -->
  <div class="cta-banner">
    <span class="overline" style="color: var(--color-teal);">Get Started</span>
    <h2>Ready to build something that works?</h2>
    <p>Tell us about your project and we'll help you find the right path forward.</p>
    <a href="contact" class="btn btn-teal">Contact Us</a>
  </div>

</PageLayout>

<style>
  .solutions-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-flow: dense;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .solutions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .partners-banner {
    background: var(--color-slate);
    padding: var(--space-16) var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .partners-banner h2 {
    color: #fff;
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .partners-banner p {
    color: rgba(255, 255, 255, 0.65);
    font-size: var(--text-lg);
    line-height: 1.65;
    max-width: 600px;
    margin: 0;
  }

  .partners-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-10);
    margin: var(--space-4) 0;
  }

  .partner-logo-link {
    display: block;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .partner-logo-link:hover {
    opacity: 1;
  }

  .partner-logo-link img {
    width: 200px;
    height: 38px;
    object-fit: contain;
    display: block;
  }
</style>
