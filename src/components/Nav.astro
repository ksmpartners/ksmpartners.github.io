---
const solutions = [
  { label: 'GxP Migration', href: 'solutions/gxp-migration' },
  { label: 'Git for Statistical Programming', href: 'solutions/git-statistical-programming' },
  { label: '12-Week SCE Scoping', href: 'solutions/sce-scoping' },
  { label: 'Domino SCE MVP Deployment', href: 'solutions/domino-sce-mvp' },
  { label: 'Dispatch Call Analytics', href: 'solutions/dispatch-call-analytics' },
];
---
<nav aria-label="Main navigation" style="display:contents">
  <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" id="nav-toggle">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <ul class="nav-links" id="nav-links">
    <li><a href="">Home</a></li>
    <li class="nav-dropdown">
      <button class="dropdown-toggle" aria-haspopup="true" aria-expanded="false" id="solutions-toggle">
        Solutions <span class="arrow">▾</span>
      </button>
      <ul class="dropdown-menu" id="solutions-menu" role="menu">
        {solutions.map(s => (
          <li role="menuitem"><a href={s.href}>{s.label}</a></li>
        ))}
      </ul>
    </li>
    <li><a href="case-studies">Case Studies</a></li>
    <li class="nav-dropdown">
      <button
        class="dropdown-toggle"
        aria-haspopup="true"
        aria-expanded="false"
        id="about-toggle"
        type="button"
      >
        About <span class="arrow">▾</span>
      </button>
      <ul class="dropdown-menu" id="about-menu" role="menu">
        <li role="menuitem"><a href="about">About Us</a></li>
        <li role="menuitem"><a href="our-team">Leadership Team</a></li>
        <li role="menuitem"><a href="our-partners">Our Partners</a></li>
      </ul>
    </li>
    <li><a href="blog">Blog</a></li>
  </ul>

  <div class="nav-cta">
    <a href="contact" class="btn btn-teal">Schedule a Call</a>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const navLinks = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const open = navLinks?.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(open));
  });

  function setupDropdown(toggleId: string, menuId: string) {
    const btn = document.getElementById(toggleId);
    const menu = document.getElementById(menuId);
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });

    // Close click-opened dropdown when mouse leaves the nav-dropdown container
    const container = btn.closest('.nav-dropdown');
    container?.addEventListener('mouseleave', () => {
      if (window.innerWidth >= 768) {
        menu.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        btn.blur();
      }
    });
  }

  setupDropdown('solutions-toggle', 'solutions-menu');
  setupDropdown('about-toggle', 'about-menu');
</script>
